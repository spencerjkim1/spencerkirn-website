{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spencerkirn-website",
  "main": "worker.js",
  "compatibility_date": "2026-11-02",
  // Remote bucket must be created before deploying; local dev uses local R2 only.
  "r2_buckets": [
    { "binding": "DRAWINGS", "bucket_name": "spencerkirn-drawings" }
  ],
  "ratelimits": [
    { "name": "DRAWINGS_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } }
  ],
  "assets": {
    "directory": "./.site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "build": {
    "command": "npm run build",
    "watch_dir": ["index.html", "demo.html", "assets", "demo", "_redirects", "worker.js", "server", "lib"]
  },
  "routes": [
    { "pattern": "spencerkirn.com", "custom_domain": true }
  ]
}
