{
  "name": "spencerkirn-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-site.mjs",
    "dev": "wrangler dev --port 8081 --infer-origin-from-routes=false",
    "dev:draw": "wrangler dev --port 8082 --infer-origin-from-routes=false --var DRAWINGS_ENABLED:true --var TURNSTILE_SITE_KEY:1x00000000000000000000AA --var TURNSTILE_SECRET_KEY:1x0000000000000000000000000000000AA",
    "spotify:connect": "node scripts/connect-spotify.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
